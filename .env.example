# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key

# Primary MySQL connection (used for Database Explorer schema inspection)
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=college_db
# Optional SSL settings for cloud MySQL providers (e.g. REQUIRED, VERIFY_CA, DISABLED)
DB_SSL_MODE=
DB_SSL_CA=

# Read-Only MySQL User for AI-Generated Query Execution (Phase 4)
DB_READONLY_USER=query_readonly
DB_READONLY_PASSWORD=your_readonly_mysql_password
MAX_QUERY_ROWS=200
QUERY_TIMEOUT_MS=5000

# Dedicated MySQL User for Query History Operations (Phase 5)
DB_HISTORY_USER=query_history_user
DB_HISTORY_PASSWORD=your_history_mysql_password

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key
# Recommended active models: gemini-3.8-flash (primary) or gemini-3.5-flash-lite (fast fallback)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
